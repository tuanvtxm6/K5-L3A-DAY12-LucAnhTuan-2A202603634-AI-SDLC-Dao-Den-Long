{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "description": "Đảo Đèn Lồng — 3D game (Three.js) with a deterministic headless mode (Test Contract v1.3)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "headless": "node src/headless.js",
    "test": "node --test tests/*.test.js",
    "proof": "node scripts/proof.js",
    "webcheck": "node scripts/webcheck.js docs/proof/phase-4",
    "bench": "node scripts/bench.js --seed 42 --duration 30 --out bench.json",
    "soak": "node --expose-gc scripts/soak.js --seed 7 --nights 10 --out soak.json"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "license": "MIT"
}
